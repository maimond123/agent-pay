    "url": "git+https://github.com/anthropics/agent-pay.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@walletconnect/sign-client": "^2.17.0",
    "@walletconnect/types": "^2.17.0",
    "qrcode-terminal": "^0.12.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
