# Server Configuration
PORT=3000
NODE_ENV=development

# Akash Network Configuration
AKASH_RPC_ENDPOINT=https://rpc.akashnet.net:443
AKASH_CHAIN_ID=akashnet-2

# Akash Wallet (Gateway wallet that deploys on behalf of users)
# Generate with: npx @akashnetwork/akashjs generate-wallet
AKASH_MNEMONIC=your twelve word mnemonic phrase here for the gateway wallet

# Akash Deployment Settings
AKASH_DEPOSIT_AMOUNT=5000000
# Certificate storage path (auto-generated on first run)
AKASH_CERT_PATH=./data/cert.json

# Network Configuration (base-sepolia for testnet, base for mainnet)
NETWORK=base-sepolia

# JWT Secret for token authentication (generate with: openssl rand -hex 32)
JWT_SECRET=generate_a_random_secret_here

# Payment Receiver Wallet (receives USDC payments via transferFrom)
# This wallet needs ETH for gas to execute transferFrom transactions
PAYMENT_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENT_RECEIVER_PRIVATE_KEY=your_private_key_here

# Pricing Configuration
MARKUP_PERCENTAGE=15
MIN_DEPLOYMENT_HOURS=1
MAX_DEPLOYMENT_HOURS=720

# Database (optional - for production)
DATABASE_URL=sqlite://./data/deployments.db

# =============================================================================
# LLM Configuration (optional - falls back to keyword-based analysis)
# =============================================================================
# OpenAI (preferred)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Or Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-haiku-20240307
