{
  "name": "verifiable-agents",
  "version": "0.1.0",
  "description": "Verifiable Agent Runtime (VAR) - Framework for AI agents with cryptographically verifiable actions via Chainlink CRE",
  "type": "module",
  "main": "dist/sdk/index.js",
  "types": "dist/sdk/index.d.ts",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/sdk/index.ts",
    "demo": "tsx examples/demo.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "tsc --noEmit",
    "cre:init": "cre init --project-name verifiable-agents",
    "cre:simulate": "cre workflow simulate",
    "cre:deploy": "cre workflow deploy"
  },
  "keywords": [
    "ai-agents",
    "chainlink",
    "cre",
    "verifiable-computation",
    "x402",
    "crypto-payments",
    "web3",
    "attestations",
    "zk-proofs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.10",
    "ethers": "^6.16.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "viem": "^2.44.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
